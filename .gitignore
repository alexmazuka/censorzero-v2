__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
*.egg-info/
# Local scratch only. Data artifacts are COMMITTED by design (reproducibility).
tmp/
# Fetch working state (spool + raw HTML cache). The committed snapshot is
# data/raw/*.parquet; the cache exists so parser fixes don't need a refetch.
cache/
# Discovery + article snapshot are committed at snapshot-freeze time via a
# dedicated commit, not as part of code commits.
# Bulk discovery bytes (weekly sitemap XML, Wayback CDX pages, UP day-archive
# HTML) are large and regenerable via `python scripts/01_snapshot.py discover-*`.
# The pipeline never reads them — it reads only data/raw/articles/*.parquet.
# The fetch input (url_universe.csv) IS committed for auditability.
data/raw/discovery/ukrinform_sitemaps/
data/raw/discovery/suspilne_cdx/
data/raw/discovery/pravda_day_archives/
# Derived intermediate (regenerated by `make interim`). Not byte-compared in CI
# because Parquet is not guaranteed byte-identical across machines; the checked,
# text artifacts (figures.json/metrics.json/counts.json/lineage.json/README)
# are derived from its content, so any real change surfaces there.
data/interim/*.parquet
data/gold/parts/
